{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card.schema.json",
  "title": "SG credit card (fact-level provenance)",
  "description": "Every fact either carries value + source_url + exact quote + source_type + last_verified, or is null with a null_reason. Information only, not financial advice.",
  "type": "object",
  "required": ["schema_version", "id", "issuer", "name", "type", "status", "product_url", "facts", "pending_changes", "notes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "issuer": {"enum": ["DBS", "OCBC", "UOB", "Citi", "HSBC", "Standard Chartered", "Maybank", "American Express", "Trust"]},
    "name": {"type": "string", "minLength": 3},
    "type": {"enum": ["miles", "cashback", "rewards", "hybrid"]},
    "network": {"type": "string"},
    "status": {"enum": ["active", "closed_to_new_applicants", "discontinued"]},
    "product_url": {"$ref": "#/$defs/url"},
    "facts": {
      "type": "object",
      "required": ["min_income_sgd", "fees", "earn", "exclusions", "conversion"],
      "additionalProperties": {"$ref": "#/$defs/fact"},
      "properties": {
        "min_income_sgd": {"$ref": "#/$defs/fact"},
        "fees": {
          "type": "object",
          "required": ["annual_fee_sgd", "first_year_waiver", "spend_based_waiver", "fx_fee_pct"],
          "additionalProperties": false,
          "properties": {
            "annual_fee_sgd": {"$ref": "#/$defs/fact"},
            "first_year_waiver": {"$ref": "#/$defs/fact"},
            "spend_based_waiver": {"$ref": "#/$defs/fact"},
            "fx_fee_pct": {"$ref": "#/$defs/fact"}
          }
        },
        "earn": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["category", "rate", "cap", "min_spend"],
            "additionalProperties": false,
            "properties": {
              "category": {"type": "string"},
              "description": {"type": "string"},
              "rate": {"$ref": "#/$defs/fact"},
              "cap": {"$ref": "#/$defs/fact"},
              "min_spend": {"$ref": "#/$defs/fact"}
            }
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "allOf": [{"$ref": "#/$defs/fact"}],
            "properties": {
              "category": {"type": "string"},
              "mccs": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{4})?$"}}
            }
          }
        },
        "conversion": {
          "type": "object",
          "required": ["ratio", "fee_sgd"],
          "additionalProperties": false,
          "properties": {"ratio": {"$ref": "#/$defs/fact"}, "fee_sgd": {"$ref": "#/$defs/fact"}}
        }
      }
    },
    "pending_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "old_value", "new_value", "effective_date", "source_url", "quote", "source_type", "last_verified"],
        "properties": {
          "field": {"type": "string"},
          "old_value": {}, "new_value": {}, "unit": {"type": "string"},
          "announced_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
          "effective_date": {"$ref": "#/$defs/date"},
          "source_url": {"$ref": "#/$defs/url"},
          "quote": {"$ref": "#/$defs/quote"},
          "source_type": {"$ref": "#/$defs/source_type"},
          "last_verified": {"$ref": "#/$defs/date"},
          "announced_date_source": {
            "type": "object",
            "required": ["source_url", "quote", "source_type", "last_verified"],
            "properties": {
              "source_url": {"$ref": "#/$defs/url"}, "quote": {"$ref": "#/$defs/quote"},
              "source_type": {"$ref": "#/$defs/source_type"}, "last_verified": {"$ref": "#/$defs/date"}, "note": {"type": "string"}
            }
          }
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "url": {"type": "string", "pattern": "^https://"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "quote": {"type": "string", "minLength": 8, "maxLength": 600},
    "source_type": {"enum": ["issuer", "third_party"]},
    "fact": {
      "oneOf": [
        {
          "title": "verified fact",
          "type": "object",
          "required": ["value", "source_url", "quote", "source_type", "last_verified"],
          "properties": {
            "value": {"not": {"type": "null"}},
            "unit": {"type": "string"},
            "period": {"enum": ["calendar_month", "statement_month", "month", "quarter", "calendar_quarter", "calendar_year", "card_year", "first_6_months", "none"]},
            "applies_to": {"type": "string"},
            "note": {"type": "string"},
            "derived": {"type": "boolean"},
            "source_url": {"$ref": "#/$defs/url"},
            "quote": {"$ref": "#/$defs/quote"},
            "source_type": {"$ref": "#/$defs/source_type"},
            "last_verified": {"$ref": "#/$defs/date"},
            "announced_date": {"$ref": "#/$defs/date"},
            "effective_date": {"$ref": "#/$defs/date"},
            "effective_to": {"$ref": "#/$defs/date"},
            "category": {"type": "string"},
            "mccs": {"type": "array"}
          },
          "additionalProperties": false
        },
        {
          "title": "unverified (null) fact",
          "type": "object",
          "required": ["value", "null_reason"],
          "properties": {
            "value": {"type": "null"},
            "null_reason": {"type": "string", "minLength": 5},
            "source_url_to_check": {"$ref": "#/$defs/url"},
            "category": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
